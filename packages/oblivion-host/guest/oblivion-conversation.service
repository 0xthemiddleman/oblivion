[Unit]
Description=Oblivion session conversation
Requires=oblivion-vault.service
After=oblivion-vault.service

[Service]
Type=simple
User=1000
Group=1000
WorkingDirectory=/vault/workspace
Environment=HOME=/vault/home
Environment=XDG_CONFIG_HOME=/vault/config
Environment=XDG_STATE_HOME=/vault/state
Environment=XDG_DATA_HOME=/vault/state
Environment=XDG_CACHE_HOME=/tmp/oblivion-cache
Environment=TMPDIR=/tmp
Environment=HISTFILE=/dev/null
Environment=TERM=linux
ExecStart=/usr/libexec/oblivion
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
LimitCORE=0
KillMode=control-group
TimeoutStopSec=10s
Restart=no

[Install]
WantedBy=multi-user.target
