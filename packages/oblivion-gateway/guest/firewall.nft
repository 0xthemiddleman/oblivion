#!/usr/sbin/nft -f
# Dedicated gateway VM: replace this VM's policy atomically before links go up.
flush ruleset
table inet oblivion {
    set reserved4 {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
            169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
            192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24,
            224.0.0.0/4, 240.0.0.0/4 }
    }
    chain input {
        type filter hook input priority filter; policy drop;
        meta nfproto ipv6 counter drop
        ct state invalid counter drop
        iifname "lo" accept
        ct state established,related accept
        iifname "inside0" ip saddr 10.88.0.2 ip daddr 10.88.0.1 tcp dport 8111 ct state new counter accept
        counter drop
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
        counter drop
    }
    chain output {
        type filter hook output priority filter; policy drop;
        meta nfproto ipv6 counter drop
        ct state invalid counter drop
        # Deny LAN, host services and metadata even to the Tor process.
        oifname "outside0" ip daddr @reserved4 counter drop
        ct state established,related accept
        # API and future tool proxy may reach only the local policy-controlled
        # Tor entry. Root uses its private Unix control socket, not TCP.
        oifname "lo" meta skuid { 1300, 1301 } ip daddr 127.0.0.1 tcp dport 9050 counter accept
        oifname "outside0" meta skuid 1200 meta l4proto tcp counter accept
        meta skuid { 1300, 1301 } counter drop
        counter drop
    }
}
