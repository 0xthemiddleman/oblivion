ARG GUEST=guest
ARG HOST=host
FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS os
ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd-sysv udev dbus util-linux e2fsprogs ca-certificates busybox-static \
    initramfs-tools kmod linux-image-${TARGETARCH} && rm -rf /var/lib/apt/lists/*
COPY script/oblivion/vm-common-setup.sh /tmp/setup
RUN sh /tmp/setup && rm /tmp/setup

FROM os AS rust-toolchain
RUN apt-get update && apt-get install -y --no-install-recommends cargo rustc gcc libc6-dev && rm -rf /var/lib/apt/lists/*

FROM rust-toolchain AS compiler
WORKDIR /build
COPY packages/oblivion-tor-state/ /oblivion-tor-state/
COPY packages/oblivion-transport/ /oblivion-transport/
COPY packages/oblivion-host/ ./
RUN cargo test --locked && cargo build --locked --release --bins --examples && cp target/release/oblivion-storage /tmp/oblivion-storage \
    && cargo build --locked --release --features lab-emulation --bin oblivion-storage
RUN mkdir /bundle && cp /tmp/oblivion-storage /bundle/oblivion-storage \
    && cp target/release/oblivion-storage /bundle/oblivion-storage-lab \
    && cp target/release/oblivion-control target/release/oblivion-manager /bundle/ \
    && cp host/*.service /bundle/ \
    && find Cargo.toml Cargo.lock src tests host ../oblivion-tor-state/Cargo.toml ../oblivion-tor-state/src ../oblivion-transport/Cargo.toml ../oblivion-transport/src -type f -print0 | sort -z | xargs -0 sha256sum > /bundle/sources.sha256 \
    && cd /bundle && sha256sum oblivion-* sources.sha256 > SHA256SUMS

# Small development bundle, overlaid only in the disposable laboratory's RAM.
# It avoids rebuilding both Debian filesystems for each controller change.
FROM scratch AS host-artifacts
COPY --from=compiler /bundle/ /

FROM os AS guest
RUN groupadd --gid 1000 oblivion && useradd --uid 1000 --gid 1000 --no-create-home --home-dir /vault/home --shell /bin/sh oblivion \
    && passwd -l root && mkdir -p /vault /usr/libexec
COPY packages/oblivion-host/guest/ /usr/lib/oblivion/guest/
COPY script/oblivion/vm-guest-fixture.sh /usr/libexec/oblivion
RUN sh /usr/lib/oblivion/guest/install.sh

FROM guest AS opencode-guest
ARG TARGETARCH
ARG OPENCODE_BUILD_EVIDENCE=docs/oblivion/privacy-evidence.json
ARG OPENCODE_BINARY=artifacts/oblivion-build/cli-linux-arm64/bin/opencode
RUN case "$TARGETARCH" in arm64|amd64) ;; *) exit 1;; esac && apt-get update && apt-get install -y --no-install-recommends \
    python3 git ripgrep && rm -rf /var/lib/apt/lists/*
COPY ${OPENCODE_BINARY} /usr/bin/oblivion
COPY ${OPENCODE_BUILD_EVIDENCE} /usr/lib/oblivion/build-evidence.json
COPY script/oblivion/vm-chat-probe.py /usr/libexec/oblivion-chat-probe
RUN python3 -c 'import hashlib,json; from pathlib import Path; assert hashlib.sha256(Path("/usr/bin/oblivion").read_bytes()).hexdigest() == json.loads(Path("/usr/lib/oblivion/build-evidence.json").read_text())["binary_sha256"]'

FROM opencode-guest AS tui-guest
COPY script/oblivion/vm-tui-guest.py /usr/libexec/oblivion
RUN chmod 0755 /usr/libexec/oblivion

FROM opencode-guest AS conversation-guest
COPY packages/oblivion-host/guest/conversation.sh /usr/libexec/oblivion
RUN chmod 0755 /usr/libexec/oblivion

# Same network setup and compiled OpenCode, with an unprivileged console probe
# instead of the interactive entrypoint. No synthetic provider in this guest.
FROM conversation-guest AS session-network-guest
COPY script/oblivion/vm-session-network-guest.py /usr/libexec/oblivion
RUN chmod 0755 /usr/libexec/oblivion

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS session-network-pack
RUN apt-get update && apt-get install -y --no-install-recommends squashfs-tools && rm -rf /var/lib/apt/lists/*
COPY packages/oblivion-host/guest/ /sources/guest/
COPY script/oblivion/vm-session-network-guest.py /sources/lab/
RUN --mount=type=bind,from=session-network-guest,source=/,target=/guest,ro \
    mkdir /out && cp /guest/boot/vmlinuz-* /out/kernel && cp /guest/boot/initrd.img-* /out/initrd \
    && mksquashfs /guest /out/session.squashfs -noappend -comp zstd -processors 2 -quiet -wildcards -e 'boot/*' \
    && cd /sources && find . -type f -print0 | sort -z | xargs -0 sha256sum > /out/sources.sha256 \
    && sha256sum /guest/usr/bin/oblivion > /out/opencode.sha256 \
    && cd /out && sha256sum * > SHA256SUMS

FROM scratch AS session-network-artifacts
COPY --from=session-network-pack /out/ /

FROM ${GUEST} AS selected-guest

FROM os AS host
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends cryptsetup-bin python3 \
    $(if [ "$TARGETARCH" = arm64 ]; then printf qemu-system-arm; else printf qemu-system-x86; fi) \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 oblivion-manager \
    && useradd --uid 1000 --gid 1000 --no-create-home --home-dir /run/oblivion-manager --shell /usr/sbin/nologin oblivion-manager \
    && groupadd --gid 1100 oblivion-vm && useradd --uid 1100 --gid 1100 --no-create-home --shell /usr/sbin/nologin oblivion-vm \
    && groupadd --gid 1101 oblivion-gateway-vm && useradd --uid 1101 --gid 1101 --no-create-home --shell /usr/sbin/nologin oblivion-gateway-vm \
    && passwd -l root
COPY --from=compiler /tmp/oblivion-storage /usr/bin/oblivion-storage
COPY --from=compiler /build/target/release/oblivion-storage /usr/bin/oblivion-storage-lab
COPY --from=compiler /build/target/release/oblivion-control /usr/bin/oblivion-control
COPY --from=compiler /build/target/release/oblivion-manager /usr/bin/oblivion-manager
COPY script/oblivion/vm-lab-test.py /usr/libexec/oblivion-vm-test
COPY script/oblivion/vm-host-setup.sh /tmp/setup
RUN sh /tmp/setup && rm /tmp/setup

FROM host AS manager-host
COPY script/oblivion/vm-manager-test.py /usr/libexec/oblivion-vm-test
RUN touch /usr/lib/oblivion/vm/manager-lab

FROM manager-host AS tui-host
RUN apt-get update && apt-get install -y --no-install-recommends python3-pyte python3-pil fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
COPY script/oblivion/vm-tui-test.py /usr/libexec/oblivion-vm-test
RUN touch /usr/lib/oblivion/vm/tui-lab

FROM ${HOST} AS selected-host

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS pack
RUN apt-get update && apt-get install -y --no-install-recommends squashfs-tools && rm -rf /var/lib/apt/lists/*
COPY --from=selected-guest / /guest/
COPY --from=selected-host / /host/
COPY packages/oblivion-host/ /sources/packages/oblivion-host/
COPY packages/oblivion-tor-state/ /sources/packages/oblivion-tor-state/
COPY packages/oblivion-transport/ /sources/packages/oblivion-transport/
COPY script/oblivion/ /sources/script/oblivion/
COPY script/oblivion/vm-lab-pack.sh /pack
RUN sh /pack

FROM scratch AS artifacts
COPY --from=pack /out/ /

# Component-only gateway bundle. Reuse the compiler layers without exporting a
# large development image; run the inherited-FD tests in the swap-free VM.
FROM rust-toolchain AS gateway-compiler
WORKDIR /gateway
ENV CARGO_TARGET_DIR=/tmp/target
COPY packages/oblivion-tor-state/ /oblivion-tor-state/
COPY packages/oblivion-transport/ /oblivion-transport/
COPY packages/oblivion-gateway/Cargo.toml packages/oblivion-gateway/Cargo.lock ./
COPY packages/oblivion-gateway/.cargo/ .cargo/
RUN cargo fetch --locked
COPY packages/oblivion-gateway/src/ src/
COPY packages/oblivion-gateway/tests/ tests/
RUN --network=none cargo test --locked --offline --lib --features lab-emulation \
    && cargo test --locked --offline --no-run --features lab-emulation \
    && mkdir /gateway-bundle \
    && cp /tmp/target/debug/oblivion-api /gateway-bundle/oblivion-api-lab \
    && cp /tmp/target/debug/oblivion-egress /gateway-bundle/oblivion-egress-lab \
    && cp $(find /tmp/target/debug/deps -type f -name 'oblivion_gateway-*' -executable) /gateway-bundle/gateway-tests \
    && cp $(find /tmp/target/debug/deps -type f -name 'activation-*' -executable) /gateway-bundle/activation-tests \
    && cargo build --locked --offline --bins \
    && cp /tmp/target/debug/oblivion-api /gateway-bundle/oblivion-api \
    && cp /tmp/target/debug/oblivion-gateway-control /gateway-bundle/oblivion-gateway-control \
    && cp /tmp/target/debug/oblivion-egress /gateway-bundle/oblivion-egress \
    && strip /gateway-bundle/* \
    && find Cargo.toml Cargo.lock .cargo src tests ../oblivion-tor-state/Cargo.toml ../oblivion-tor-state/src ../oblivion-transport/Cargo.toml ../oblivion-transport/src -type f -print0 | sort -z | xargs -0 sha256sum > /gateway-bundle/sources.sha256 \
    && rustc --version > /gateway-bundle/compiler.txt \
    && cd /gateway-bundle && sha256sum * > SHA256SUMS

FROM scratch AS gateway-artifacts
COPY --from=gateway-compiler /gateway-bundle/ /

FROM os AS gateway-system
RUN apt-get update && apt-get install -y --no-install-recommends tor nftables iproute2 \
    && rm -rf /var/lib/apt/lists/*
COPY packages/oblivion-gateway/guest/ /gateway-config/
COPY --from=gateway-compiler /gateway-bundle/oblivion-api /usr/bin/oblivion-api
COPY --from=gateway-compiler /gateway-bundle/oblivion-gateway-control /usr/bin/oblivion-gateway-control
COPY --from=gateway-compiler /gateway-bundle/oblivion-egress /usr/bin/oblivion-egress
RUN sh /gateway-config/install.sh && rm -rf /gateway-config
# BuildKit mounts its own resolver read-only during RUN; COPY replaces the
# image's file without touching that build-time mount.
COPY packages/oblivion-gateway/guest/resolv.conf /etc/resolv.conf

# Diagnostics exist only in this separate laboratory image.
FROM gateway-system AS gateway-network-lab
RUN apt-get update && apt-get install -y --no-install-recommends python3 curl \
    && rm -rf /var/lib/apt/lists/*
COPY script/oblivion/vm-network-fixture.py /usr/libexec/oblivion-network-fixture
COPY script/oblivion/vm-network-setup.sh /tmp/network-setup
RUN sh /tmp/network-setup && rm /tmp/network-setup

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS gateway-network-pack
RUN apt-get update && apt-get install -y --no-install-recommends squashfs-tools && rm -rf /var/lib/apt/lists/*
COPY packages/oblivion-gateway/guest/ /sources/guest/
COPY script/oblivion/vm-network-fixture.py script/oblivion/vm-network-setup.sh /sources/lab/
COPY --from=gateway-compiler /gateway-bundle/sources.sha256 /sources/broker.sha256
RUN --mount=type=bind,from=gateway-system,source=/,target=/gateway,ro \
    --mount=type=bind,from=gateway-network-lab,source=/,target=/lab,ro \
    mkdir /out \
    && cp /gateway/boot/vmlinuz-* /out/kernel \
    && cp /gateway/boot/initrd.img-* /out/initrd \
    && mksquashfs /gateway /out/gateway.squashfs -noappend -comp zstd -processors 2 -quiet -wildcards -e 'boot/*' \
    && mksquashfs /lab /out/laboratory.squashfs -noappend -comp zstd -processors 2 -quiet -wildcards -e 'boot/*' \
    && chroot /gateway dpkg-query -W -f='${Package}\t${Version}\n' > /out/gateway-packages.tsv \
    && chroot /lab dpkg-query -W -f='${Package}\t${Version}\n' > /out/lab-packages.tsv \
    && cd /sources && find . -type f -print0 | sort -z | xargs -0 sha256sum > /out/sources.sha256 \
    && cp broker.sha256 /out/broker-sources.sha256 \
    && cd /out && sha256sum * > SHA256SUMS

FROM scratch AS gateway-network-artifacts
COPY --from=gateway-network-pack /out/ /

# Lab-only trust overlay. Retain the exact diff; neither production stage above
# uses this binary or certificate. Runtime activation/hardening stay unchanged.
FROM gateway-compiler AS stream-compiler
COPY script/oblivion/vm-stream-cert.pem /fixture/cert.pem
RUN test "$(grep -cF '.https_only(true)' src/broker.rs)" = 1 \
    && cp src/broker.rs /tmp/production-broker.rs \
    && sed -i '/\.https_only(true)/a\            .add_root_certificate(reqwest::Certificate::from_pem(include_bytes!("/fixture/cert.pem")).expect("laboratory certificate"))' src/broker.rs \
    && mkdir /stream-bundle \
    && (diff -u /tmp/production-broker.rs src/broker.rs > /stream-bundle/trust.diff; test "$?" = 1) \
    && cargo build --locked --offline --bin oblivion-api \
    && cp /tmp/target/debug/oblivion-api /stream-bundle/oblivion-api \
    && strip /stream-bundle/oblivion-api

FROM gateway-network-lab AS stream-gateway
COPY --from=stream-compiler /stream-bundle/oblivion-api /usr/bin/oblivion-api
COPY --from=stream-compiler /stream-bundle/trust.diff /usr/lib/oblivion-stream-fixture/trust.diff
COPY script/oblivion/vm-stream-cert.pem /usr/lib/oblivion-stream-fixture/cert.pem
COPY script/oblivion/vm-stream-key.pem /usr/lib/oblivion-stream-fixture/key.pem
COPY script/oblivion/vm-stream-provider.py /usr/lib/oblivion-stream-fixture/provider.py
COPY script/oblivion/vm-stream-provider.service /etc/systemd/system/oblivion-stream-provider.service
RUN sed -i 's/^SocksPort .*/SocksPort 0/' /etc/oblivion/torrc \
    && mkdir -p /etc/systemd/system/oblivion-gateway.target.wants \
    && ln -s /etc/systemd/system/oblivion-stream-provider.service /etc/systemd/system/oblivion-gateway.target.wants/

FROM session-network-guest AS stream-session
COPY artifacts/oblivion-adapter-broker/cli-01/cli-linux-arm64/bin/opencode /usr/bin/oblivion
COPY docs/oblivion/adapter-broker-evidence.json /usr/lib/oblivion/adapter-evidence.json
RUN python3 -c 'import hashlib,json; from pathlib import Path; assert hashlib.sha256(Path("/usr/bin/oblivion").read_bytes()).hexdigest() == json.loads(Path("/usr/lib/oblivion/adapter-evidence.json").read_text())["cli_build"]["sha256"]'

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS stream-pack
RUN apt-get update && apt-get install -y --no-install-recommends squashfs-tools && rm -rf /var/lib/apt/lists/*
RUN --mount=type=bind,from=stream-gateway,source=/,target=/gateway,ro \
    --mount=type=bind,from=stream-session,source=/,target=/session,ro \
    mkdir -p /stream-out/gateway /stream-out/session \
    && cp /gateway/boot/vmlinuz-* /stream-out/gateway/kernel \
    && cp /gateway/boot/initrd.img-* /stream-out/gateway/initrd \
    && cp /session/boot/vmlinuz-* /stream-out/session/kernel \
    && cp /session/boot/initrd.img-* /stream-out/session/initrd \
    && mksquashfs /gateway /stream-out/gateway/gateway.squashfs -noappend -comp zstd -processors 2 -quiet -wildcards -e 'boot/*' \
    && mksquashfs /session /stream-out/session/session.squashfs -noappend -comp zstd -processors 2 -quiet -wildcards -e 'boot/*' \
    && chroot /gateway python3 -c 'import hashlib,json; from pathlib import Path; print(json.dumps({key:hashlib.sha256(Path(path).read_bytes()).hexdigest() for key,path in {"provider_sha256":"/usr/lib/oblivion-stream-fixture/provider.py","api_sha256":"/usr/bin/oblivion-api","certificate_sha256":"/usr/lib/oblivion-stream-fixture/cert.pem","trust_diff_sha256":"/usr/lib/oblivion-stream-fixture/trust.diff"}.items()}))' > /stream-out/gateway/stream.json \
    && cp /gateway/usr/lib/oblivion-stream-fixture/trust.diff /stream-out/gateway/ \
    && cp /session/usr/lib/oblivion/adapter-evidence.json /stream-out/session/ \
    && sha256sum /session/usr/bin/oblivion > /stream-out/session/opencode.sha256 \
    && cd /stream-out/gateway && sha256sum * > SHA256SUMS \
    && cd /stream-out/session && sha256sum * > SHA256SUMS

FROM scratch AS stream-artifacts
COPY --from=stream-pack /stream-out/ /

# Reuse a previously verified session image while changing gateway-only fixtures.
FROM scratch AS stream-gateway-artifacts
COPY --from=stream-pack /stream-out/gateway/ /

# Transport integration lab: the production supervisor/connector/firewall with
# a lab-only API trust root. No local synthetic SOCKS service is auto-started.
FROM gateway-network-lab AS transport-network-lab
COPY --from=stream-compiler /stream-bundle/oblivion-api /usr/bin/oblivion-api
COPY --from=stream-compiler /stream-bundle/trust.diff /usr/lib/oblivion-transport-fixture/trust.diff

FROM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS transport-network-pack
RUN apt-get update && apt-get install -y --no-install-recommends squashfs-tools && rm -rf /var/lib/apt/lists/*
COPY packages/oblivion-gateway/guest/ /sources/guest/
COPY script/oblivion/vm-network-fixture.py script/oblivion/vm-network-setup.sh /sources/lab/
COPY --from=gateway-compiler /gateway-bundle/sources.sha256 /sources/broker.sha256
RUN --mount=type=bind,from=transport-network-lab,source=/,target=/lab,ro \
    mkdir /out && cp /lab/boot/vmlinuz-* /out/kernel && cp /lab/boot/initrd.img-* /out/initrd \
    && mksquashfs /lab /out/laboratory.squashfs -noappend -comp zstd -processors 2 -quiet -wildcards -e 'boot/*' \
    && cp /lab/usr/lib/oblivion-transport-fixture/trust.diff /out/trust.diff \
    && sha256sum /lab/usr/bin/oblivion-api /lab/usr/bin/oblivion-egress /lab/usr/bin/oblivion-gateway-control > /out/binaries.sha256 \
    && cd /sources && find . -type f -print0 | sort -z | xargs -0 sha256sum > /out/sources.sha256 \
    && cp broker.sha256 /out/broker-sources.sha256 \
    && cd /out && sha256sum * > SHA256SUMS

FROM scratch AS transport-network-artifacts
COPY --from=transport-network-pack /out/ /
